# OS
.DS_Store
Thumbs.db

# Obsidian local state (machine-specific, no value in sharing)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/node_modules/
.obsidian/plugins/*/data.json

# Claude / Claudian session files (local session state, not knowledge)
.claude/
.claudian/

# Large binary assets
raw/assets/*.mp4
raw/assets/*.mov
raw/assets/*.zip

# ---------------------------------------------------------------------------
# apps/ — see apps/README.md
# ---------------------------------------------------------------------------

# outreach-engine is its own git repo with its own GitHub remote
# (RatherN-t/Civly-outreach-engine). The vault must not swallow it.
/apps/outreach-engine/

# Build output, dependencies, and virtualenvs anywhere under apps/
apps/**/node_modules/
apps/**/.venv/
apps/**/venv/
apps/**/__pycache__/
apps/**/dist/
apps/**/build/
apps/**/.next/
apps/**/.vercel/
apps/**/*.egg-info/
apps/**/*.py[cod]

# Secrets and local data — never commit
apps/**/.env
apps/**/.env.*
!apps/**/.env.example
apps/**/*.sqlite
apps/**/*.sqlite3
apps/**/data/
